# Hauptdomain ist https://designtech.eu (ohne www).
# www und http dauerhaft (301) dorthin weiterleiten.
# Greift nur für designtech.eu – andere Domains auf demselben Webspace
# (z. B. in Unterordnern) bleiben unberührt.
# IfModule: Ohne mod_rewrite werden die Regeln ignoriert statt Fehler 500.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^(www\.)?designtech\.eu$ [NC]
  RewriteCond %{HTTP_HOST} ^www\. [NC,OR]
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://designtech.eu/$1 [R=301,L]
</IfModule>
